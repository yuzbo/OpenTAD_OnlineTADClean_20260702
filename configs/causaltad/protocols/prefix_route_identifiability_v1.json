    "name": "model_outcome_blind_annotation_census",
    "definitions": {
      "frame_scale": "alpha_v=frame_count_v/duration_seconds_v",
      "start_frame": "s_frame=alpha_v*start_seconds",
      "end_frame": "e_frame=alpha_v*end_seconds",
      "feature_stride_frames": 8,
      "decision_frame": "d_j=min((j+1)*8,frame_count_v)-1",
      "decision_bin": "b_v(x)=min{j:x<=d_j}",
      "interval_semantics": "half_open_[start,end)",
      "touching_is_overlap": false,
      "birth": "d_(j-1)<s_i<=d_j",
      "active": "s_i<=d_j<e_i",
      "end": "d_(j-1)<e_i<=d_j",
      "pair_overlap": "max(0,min(e_i,e_k)-max(s_i,s_k))",
      "same_class_repeated": "at_least_two_legal_instances_of_same_class_in_one_video",
      "sequential_gap": "next_start-current_end",
      "gap_sign": {
        "positive": "separated",
        "zero": "touching",
        "negative": "overlap"
      },
      "same_bin_end_start": "i!=k and b_v(e_i)=b_v(s_k)",
      "direct_complete": "b_v(s_i)=b_v(e_i)",
      "ambiguous_policy": "report_separately_then_exclude_from_legal_action_statistics",
      "zero_action_video": "no_legal_action_interval_after_ambiguous_exclusion"
    },
